# ---- Core ----
DATABASE_URL="postgresql://user:password@host:5432/leadgen"

# Secret used to sign session tokens. REQUIRED in production.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="change-me-in-production"

# Public base URL of the app (used in emails, redirects)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ---- Stripe (legacy / test) ----
STRIPE_MODE="test"
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# ---- Lemon Squeezy (production payment provider) ----
# API key from the Lemon Squeezy dashboard. NEVER commit a real value.
LEMON_SQUEEZY_API_KEY=""
# Lemon Squeezy store id (already created).
LEMON_SQUEEZY_STORE_ID="1392239"
# Webhook signing secret. NEVER commit a real value.
LEMON_SQUEEZY_WEBHOOK_SECRET=""
# Variant ids from the existing Lemon Squeezy products.
LEMON_SQUEEZY_PRO_VARIANT_ID="2174275"
LEMON_SQUEEZY_BUSINESS_VARIANT_ID="2174291"
LEMON_SQUEEZY_LIFETIME_VARIANT_ID="2174300"

# ---- Email ----
EMAIL_PROVIDER="console"
EMAIL_FROM="AutoEco <no-reply@example.com>"
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""

# ---- Data providers ----
GOOGLE_PLACES_API_KEY=""
OSM_NOMINATIM_URL="https://nominatim.openstreetmap.org"
OSM_OVERPASS_URL="https://overpass-api.de/api/interpreter"

# ---- AI / CAPTCHA ----
AI_ENRICHMENT_ENABLED="false"
OPENAI_API_KEY=""
CAPTCHA_PROVIDER=""
TURNSTILE_SECRET_KEY=""
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""

# ---- Seed ----
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD=""
