# ---- Core ----
# SQLite for development. Use PostgreSQL in production, e.g.
# DATABASE_URL="postgresql://user:password@host:5432/leadgen"
DATABASE_URL="file:./dev.db"

# Secret used to sign session tokens and API-key independent HMACs. REQUIRED in production.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="change-me-in-production"

# Public base URL of the app (used in emails, redirects)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ---- Stripe (legacy / test) ----
STRIPE_MODE="test"
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# ---- Email ----
EMAIL_PROVIDER="console"
EMAIL_FROM="AutoEco <no-reply@example.com>"
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""

# ---- Data providers ----
GOOGLE_PLACES_API_KEY=""
OSM_NOMINATIM_URL="https://nominatim.openstreetmap.org"
OSM_OVERPASS_URL="https://overpass-api.de/api/interpreter"

# ---- AI / CAPTCHA ----
AI_ENRICHMENT_ENABLED="false"
OPENAI_API_KEY=""
CAPTCHA_PROVIDER=""
TURNSTILE_SECRET_KEY=""
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""

# ---- Seed ----
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD=""
