# ---- Core ----
# SQLite for development. Use PostgreSQL in production, e.g.
# DATABASE_URL="postgresql://user:password@host:5432/autoeco"
DATABASE_URL="file:./dev.db"

# Secret used to sign session tokens. REQUIRED in production (32+ chars).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="change-me-in-production"

# Public base URL of the app (used in emails, redirects, sitemap, robots)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Optional SEO override for canonical/OG URLs. Leave EMPTY in almost every
# case: sitemap.ts, robots.ts and metadata resolve the origin automatically
# from the Vercel production domain, then fall back to NEXT_PUBLIC_APP_URL.
# Set it only if your canonical domain differs from the app URL.
NEXT_PUBLIC_SITE_URL=""

# ---- Paddle (production payment provider) ----
# API key from Paddle Dashboard -> Developer Tools -> Authentication.
# NEVER commit a real value. Set this in your Vercel project.
PADDLE_API_KEY=""
# Webhook signing secret from Paddle Dashboard -> Webhooks -> Endpoint.
PADDLE_WEBHOOK_SECRET=""
# Seller / account id from Paddle Dashboard -> Developer Tools.
PADDLE_SELLER_ID=""
# Price ids, one per PAID plan in prisma/seed.ts: pro | family | pro_plus.
# Find them under Catalog -> Prices. Plan "free" has no price id.
PADDLE_PRO_PRICE_ID=""
PADDLE_FAMILY_PRICE_ID=""
# Paddle has no separate "business" product: this is the price for the
# highest paid tier, which is the `pro_plus` plan.
PADDLE_BUSINESS_PRICE_ID=""
# Optional one-off lifetime price. When set, a purchase against it also
# grants the `pro_plus` tier.
PADDLE_LIFETIME_PRICE_ID=""
# Server-side Paddle environment. Defaults to "sandbox" when unset.
# Set to "live" in Vercel ONLY when you are ready to charge real money.
PADDLE_ENV="sandbox"
# Client-side token (public, NEXT_PUBLIC_) used by Paddle.js in the
# browser. NEVER put the API key here.
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=""
# Must match PADDLE_ENV. Paddle.js refuses to open a live checkout unless
# this is explicitly set to "live".
NEXT_PUBLIC_PADDLE_ENV="sandbox"

# ---- Email ----
# "console" logs emails instead of sending them. Use "smtp" in production.
# NOTE: with EMAIL_PROVIDER="console", verification and password-reset emails
# reach NOBODY. /api/health reports this as a degraded check.
EMAIL_PROVIDER="console"
EMAIL_FROM="AutoEco <no-reply@example.com>"
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""

# ---- Cron (Vercel Cron) ----
# Shared secret required by every /api/cron/* route. Vercel sends it as the
# `Authorization: Bearer <CRON_SECRET>` header. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=""
# Grace period, in days, between "delete account" and /api/cron/purge-deleted
# removing the residual personal data. During this window support can restore
# a mistaken deletion. Minimum 1, default 30.
PURGE_AFTER_DAYS="30"

# ---- Analytics ----
# OPTIONAL. Leave empty to keep analytics strictly internal (events are stored
# in the AnalyticsEvent table and can be queried there). Setting an endpoint
# forwards events to a privacy-friendly vendor, which is a third-party
# disclosure: only do it once you have a lawful basis and publish an
# analytics/cookie notice. No PII is ever forwarded — see src/lib/analytics.ts.
ANALYTICS_ENDPOINT=""
# Optional bearer token sent to the analytics endpoint.
ANALYTICS_WRITE_KEY=""

# ---- Rate limiting / abuse protection ----
# None configured means protection is limited to per-IP rate limits.
# "turnstile" enables bot protection on signup/login; see CAPTCHA_* below.
CAPTCHA_PROVIDER=""
TURNSTILE_SECRET_KEY=""
# Public site key for the Turnstile widget on /signup (client side).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""

# ---- AI (Ask Your Car) ----
# Leave empty to use the built-in deterministic answers, which are always
# computed from the user's own recorded data. Set a key to enable the
# optional LLM phrasing layer over the same verified facts.
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
# Optional enrichment of manually entered vehicle specs. Off by default.
AI_ENRICHMENT_ENABLED="false"

# ---- Receipt / document storage ----
# Driver selection: "s3" or "local". Left empty it is inferred — s3 when a
# bucket and credentials are set, local otherwise. Set it explicitly to
# override.
STORAGE_DRIVER=""
# S3-compatible object storage (AWS S3, Cloudflare R2, MinIO). Use this in
# production: local disk on a serverless host loses every upload on redeploy.
# S3_ENDPOINT is empty for AWS S3; set it to the R2/MinIO endpoint otherwise.
# R2 requires S3_REGION="auto".
S3_ENDPOINT=""
S3_REGION="auto"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
# Local disk path, used only by the local driver. On a serverless host set it
# to a mounted persistent volume, otherwise uploads are lost on redeploy.
STORAGE_DIR=""
# Platform-set detection flags, read by src/lib/storage.ts to refuse uploads on
# an ephemeral filesystem. Never set these by hand: Vercel and AWS Lambda inject
# them automatically (VERCEL=1, AWS_LAMBDA_FUNCTION_NAME=<function>).
VERCEL=""
AWS_LAMBDA_FUNCTION_NAME=""

# ---- Vehicle spec lookup (optional) ----
# Only used when AI_ENRICHMENT_ENABLED="true". The app works without these:
# all vehicle data is entered manually by design.
GOOGLE_PLACES_API_KEY=""
OSM_NOMINATIM_URL="https://nominatim.openstreetmap.org"
OSM_OVERPASS_URL="https://overpass-api.de/api/interpreter"

# ---- Seed ----
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD=""

# ---- Tests ----
# Real-DB integration tests refuse to run against a remote database unless
# this is exactly "1". NEVER set it while DATABASE_URL points at production.
ALLOW_TEST_DB_WRITES=""