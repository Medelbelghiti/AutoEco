{
  "name": "autoeco",
  "version": "2.0.0",
  "private": true,
  "description": "AutoEco — track fuel, maintenance and expenses to calculate the true cost of car ownership",
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/build-with-migrate.js",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "next lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:launch": "node scripts/launch-check.mjs",
    "check:launch:db": "node scripts/launch-check.mjs --db",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run check:launch",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:seed": "tsx prisma/seed.ts",
    "postinstall": "prisma generate"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1146.0",
    "@prisma/client": "^5.20.0",
    "bcryptjs": "^2.4.3",
    "jose": "^5.9.3",
    "libphonenumber-js": "^1.11.9",
    "lucide-react": "^1.47.0",
    "next": "^14.2.35",
    "nodemailer": "^10.0.14",
    "pdf-lib": "^1.17.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.16.10",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^18.3.10",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.35",
    "postcss": "^8.4.47",
    "prisma": "^5.20.0",
    "tailwindcss": "^3.4.13",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "vitest": "^2.1.2"
  }
}
