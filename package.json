{
  "name": "leadgen-2",
  "version": "2.0.0",
  "private": true,
  "description": "LeadGen 2.0 — Global business lead discovery platform (SaaS)",
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/build-with-migrate.js",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "next lint",
    "test": "vitest run",
