// AutoEco — Prisma schema
// Multi-tenant SaaS for personal automotive financial tracking.
// Every customer-owned entity carries userId (or organizationId).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ----------------------------- Auth & Users -----------------------------

model User {
  id           String  @id @default(cuid())
  email        String  @unique
  passwordHash String
  name         String?
  role         String  @default("USER") // USER | ADMIN
  locale       String  @default("en")

  // Preferences
  country      String? // ISO-3166 alpha-2
  currency     String  @default("USD")
  distanceUnit String  @default("km") // km | mi
  fuelUnit     String  @default("L_PER_100KM") // L_PER_100KM | MPG | KM_PER_L

  // Billing
  stripeCustomerId String?   @unique
  // Provider-neutral identifier (Lemon Squeezy customer id, or any future
  // provider that does not use Stripe's customer model). Always nullable
  // so legacy Stripe-only users remain compatible.
  lemonCustomerId  String?   @unique
  // Paddle customer id (server-side correlation key for incoming webhooks
  // and for the Paddle Customer Portal). Always nullable so legacy
  // Stripe-only users remain compatible.
  paddleCustomerId String?   @unique
  planId           String?
  plan             Plan?     @relation("UserPlan", fields: [planId], references: [id])
  trialEndsAt      DateTime?
  trialUsed        Boolean   @default(false)

  emailVerifiedAt DateTime?

  // Anti-abuse
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?
  lastLoginAt         DateTime?
  signupIp            String?

  // Relations
  vehicles          Vehicle[]
  expenses          Expense[]
  fuelEntries       FuelEntry[]
  documents         Document[]
  forecasts         Forecast[]
  scenarios         Scenario[]
  conversations     Conversation[]
  achievements      Achievement[]
  reports           Report[]
  shareLinks        ShareLink[]
  notifications     Notification[]
  tokens            VerificationToken[]
  auditLogs         AuditLog[]
  subscriptions     Subscription[]
  invoices          Invoice[]
  apiKeys           ApiKey[]
  couponRedemptions CouponRedemption[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([role])
  @@index([email])
}

model VerificationToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  type      String // VERIFY_EMAIL | PASSWORD_RESET
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, type])
}

// ----------------------------- Plans & Billing -----------------------------

model Plan {
  id            String  @id @default(cuid())
  key           String  @unique // free | pro | family | pro_plus
  name          String
  description   String?
  priceCents    Int     @default(0)
  currency      String  @default("usd")
  billingPeriod String  @default("MONTHLY") // FREE | MONTHLY | YEARLY | LIFETIME

  // Limits
  maxVehicles             Int     @default(1)
  maxExpensesPerMonth     Int     @default(100)
  aiReceiptScansPerMonth  Int     @default(0)
  aiConversationsPerMonth Int     @default(0)
  reportRetentionDays     Int     @default(30)
  forecastHorizonMonths   Int     @default(12)
  enableAdvancedScenarios Boolean @default(false)
  enableShareableReports  Boolean @default(false)
  enableFamilySharing     Boolean @default(false)
  enableApiAccess         Boolean @default(false)

  features        String  @default("[]") // JSON array of feature labels
  stripePriceId   String?
  stripeProductId String?
  active          Boolean @default(true)
  // Marks rows that were created by tests and must NEVER appear in
  // pricing pages, billing flows, or any other user-facing surface.
  // Production plans (free / pro / family / lifetime / pro_plus) always
  // have isDemo=false. The default is false so historical rows remain
  // unaffected. Tests must explicitly set isDemo=true.
  isDemo          Boolean @default(false)
  sortOrder       Int     @default(0)

  users         User[]         @relation("UserPlan")
  subscriptions Subscription[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Subscription {
  id                   String    @id @default(cuid())
  userId               String
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  planId               String
  plan                 Plan      @relation(fields: [planId], references: [id])
  stripeSubscriptionId String?   @unique
  // Provider-neutral subscription id (Lemon Squeezy subscription id).
  // Always nullable. The internal application logic uses `status` to
  // decide entitlements — provider-specific id fields are only used to
  // correlate incoming webhooks with existing rows.
  lemonSubscriptionId  String?   @unique
  // Paddle subscription id. Always nullable.
  paddleSubscriptionId String?   @unique
  status               String // active | trialing | past_due | canceled | incomplete | unpaid | lifetime
  currentPeriodStart   DateTime?
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean   @default(false)
  canceledAt           DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@index([userId, status])
}

model Invoice {
  id              String    @id @default(cuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  stripeInvoiceId String    @unique
  // Provider-neutral order/invoice id (Lemon Squeezy order id).
  lemonOrderId    String?   @unique
  // Paddle transaction / order id (server-side correlation key).
  paddleOrderId   String?   @unique
  number          String?
  amountCents     Int
  currency        String    @default("usd")
  status          String
  planName        String?
  hostedUrl       String?
  pdfUrl          String?
  periodStart     DateTime?
  periodEnd       DateTime?
  createdAt       DateTime  @default(now())

  @@index([userId])
}

model WebhookEvent {
  id              String    @id @default(cuid())
  eventId         String    @unique
  type            String
  // State machine: RECEIVED → PROCESSING → PROCESSED | FAILED.
  // Default for existing rows: PROCESSED if processedAt is set, else RECEIVED.
  status          String    @default("RECEIVED")
  attempts        Int       @default(0)
  // Random opaque token that identifies the CURRENT owner of this event.
  // Every claim() generates a new token. markProcessed/markFailed REQUIRE
  // the matching token — a stale worker that lost ownership can no
  // longer finalize the event. The token rotates on each new claim.
  processingToken String?
  processedAt     DateTime?
  error           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model Coupon {
  id                String    @id @default(cuid())
  code              String    @unique
  type              String // PERCENT | FIXED
  value             Int
  duration          String    @default("ONCE")
  durationMonths    Int?
  firstPurchaseOnly Boolean   @default(false)
  expiresAt         DateTime?
  maxRedemptions    Int?
  perUserLimit      Int       @default(1)
  minPurchaseCents  Int?
  planKeys          String    @default("[]") // JSON
  active            Boolean   @default(true)
  timesRedeemed     Int       @default(0)
  stripeCouponId    String?
  createdAt         DateTime  @default(now())

  redemptions CouponRedemption[]
}

model CouponRedemption {
  id        String   @id @default(cuid())
  couponId  String
  coupon    Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([couponId])
  @@index([userId])
}

// ----------------------------- Vehicle catalog -----------------------------
// Normalized, market-aware vehicle catalog. Marked isDemo=false; sample
// records can be added by the admin with isDemo=true for UI previews.

model VehicleCatalogEntry {
  id                   String   @id @default(cuid())
  brand                String
  model                String
  generation           String?
  trim                 String?
  yearFrom             Int?
  yearTo               Int?
  market               String? // ISO-3166 alpha-2 or region
  fuelType             String? // gasoline | diesel | hybrid | plugin_hybrid | ev | lpg
  transmission         String?
  drivetrain           String?
  engineDisplacementCc Int?
  horsepowerHp         Int?
  torqueNm             Int?
  fuelEconomyCombined  String? // text e.g. "6.4 L/100km" — explicit unit
  batteryCapacityKwh   Float?
  evRangeKm            Int?
  curbWeightKg         Int?
  msrpCents            Int?
  source               String?
  sourceId             String?
  sourceUrl            String?
  verified             Boolean  @default(false)
  isDemo               Boolean  @default(false)
  notes                String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([brand, model, yearFrom])
  @@index([market])
}

// ----------------------------- Vehicles (user-owned) -----------------------------

model Vehicle {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Identity
  nickname             String? // user-chosen display name
  brand                String
  model                String
  generation           String?
  trim                 String?
  year                 Int
  market               String? // user country/market
  fuelType             String  @default("gasoline")
  transmission         String?
  drivetrain           String?
  engineDisplacementCc Int?
  horsepowerHp         Int?
  fuelEconomyText      String? // "6.4 L/100km"

  // Ownership
  purchaseDate            DateTime?
  purchasePriceCents      Int?
  purchaseCurrency        String?
  currentMileage          Int? // km or mi depending on user.distanceUnit
  currentMileageUnit      String? // km | mi
  estimatedResaleCents    Int?
  estimatedResaleCurrency String?

  // Misc
  licensePlate String?
  vin          String?
  isPrimary    Boolean @default(false)
  archived     Boolean @default(false)
  isDemo       Boolean @default(false)
  notes        String?

  expenses    Expense[]
  fuelEntries FuelEntry[]
  documents   Document[]
  forecasts   Forecast[]
  scenarios   Scenario[]
  reports     Report[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Strongly-typed server-side quota rows. Concurrency-safe via UNIQUE
  // (userId, metric, periodKey) + atomic increment (UPDATE ... SET used = used + 1
  // WHERE used < limit). The check + increment happens in a single statement
  // so 100 concurrent AI requests against limit=10 cannot exceed 10.
  // Missing rows are auto-created on first consumption (upsert-style).

  @@index([userId, archived])
  @@index([userId, isPrimary])
}

// ----------------------------- Expenses -----------------------------

model Expense {
  id        String  @id @default(cuid())
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  vehicleId String
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  category     String // fuel | maintenance | repair | insurance | tax | registration | tires | parking | tolls | cleaning | accessories | financing | charging | other
  amountCents  Int
  currency     String
  date         DateTime
  merchant     String?
  mileage      Int?
  mileageUnit  String?
  notes        String?
  receiptUrl   String? // signed URL reference
  recurring    Boolean  @default(false)
  source       String   @default("manual") // manual | receipt_scan | import
  aiConfidence Float?
  isDemo       Boolean  @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, date])
  @@index([vehicleId, date])
  @@index([userId, category])
}

// ----------------------------- Fuel entries -----------------------------
// Dedicated table for fuel entries to compute consumption precisely.

model FuelEntry {
  id        String  @id @default(cuid())
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  vehicleId String
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  date         DateTime
  amountCents  Int
  currency     String
  liters       Float? // if fuel
  kwh          Float? // if electric
  pricePerUnit Float?
  mileage      Int
  mileageUnit  String
  fullTank     Boolean  @default(true)
  station      String?
  consumption  Float? // computed L/100km or km/L
  notes        String?
  isDemo       Boolean  @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([vehicleId, date])
  @@index([userId, date])
}

// ----------------------------- Documents -----------------------------

model Document {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  vehicleId String?
  vehicle   Vehicle? @relation(fields: [vehicleId], references: [id], onDelete: SetNull)

  title      String
  category   String // insurance | registration | invoice | receipt | service | purchase | other
  storageKey String // server-side storage path; never expose directly
  mimeType   String
  sizeBytes  Int
  expiryDate DateTime?

  createdAt DateTime @default(now())

  @@index([userId, category])
  @@index([vehicleId])
}

// ----------------------------- Forecasts -----------------------------

model Forecast {
  id        String  @id @default(cuid())
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  vehicleId String
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  horizonMonths Int
  // JSON snapshot of inputs/assumptions and outputs
  inputsJson    String
  outputsJson   String
  createdAt     DateTime @default(now())

  @@index([vehicleId, createdAt])
}

// ----------------------------- Scenarios -----------------------------

model Scenario {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  vehicleId String?
  vehicle   Vehicle? @relation(fields: [vehicleId], references: [id], onDelete: SetNull)

  name        String
  type        String // keep_vs_replace | repair_vs_replace | mileage_change | fuel_price_change
  inputsJson  String
  outputsJson String

  createdAt DateTime @default(now())

  @@index([userId, type])
}

// ----------------------------- AI conversations -----------------------------

model Conversation {
  id        String  @id @default(cuid())
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  vehicleId String?

  title     String?
  createdAt DateTime @default(now())

  messages ConversationMessage[]

  @@index([userId, createdAt])
}

model ConversationMessage {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String // user | assistant | system
  content        String
  tokenCount     Int?
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
}

// ----------------------------- Achievements / savings -----------------------------

model Achievement {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  key        String // first_expense | first_fuel | 30_day_tracker | first_report | first_forecast | first_comparison
  unlockedAt DateTime @default(now())

  @@unique([userId, key])
}

// ----------------------------- Reports -----------------------------

model Report {
  id        String  @id @default(cuid())
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  vehicleId String
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  title     String
  format    String // json | pdf | csv
  payload   String // JSON content
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

// ----------------------------- Share links -----------------------------

model ShareLink {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String    @unique
  reportId  String?
  expiresAt DateTime?
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// ----------------------------- Notifications -----------------------------

model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  body      String?
  link      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt])
}

// ----------------------------- Settings / Flags / Rate limit -----------------------------

model FeatureFlag {
  key         String   @id
  enabled     Boolean  @default(false)
  description String?
  updatedAt   DateTime @updatedAt
}

model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model ApiKey {
  id              String    @id @default(cuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name            String
  prefix          String
  keyHash         String    @unique
  scopes          String    @default("[]")
  rateLimitPerMin Int       @default(60)
  monthlyQuota    Int?
  lastUsedAt      DateTime?
  revokedAt       DateTime?
  expiresAt       DateTime?
  createdAt       DateTime  @default(now())

  @@index([userId])
}

model RateLimitEntry {
  key     String   @id
  count   Int      @default(0)
  resetAt DateTime
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  metadata  String?
  ip        String?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([action, createdAt])
}

model AnalyticsEvent {
  id        String   @id @default(cuid())
  userId    String?
  event     String
  metadata  String?
  createdAt DateTime @default(now())

  @@index([event, createdAt])
}

// ----------------------------- Savings goals -----------------------------

model SavingsGoal {
  id          String    @id @default(cuid())
  userId      String
  vehicleId   String?
  name        String
  category    String // monthly_fuel | monthly_parking | maintenance_fund | replacement_fund | custom
  targetCents Int
  savedCents  Int       @default(0)
  currency    String    @default("USD")
  deadline    DateTime?
  achievedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([userId, achievedAt])
}

// ----------------------------- Quota usage -----------------------------
// Authoritative per-user, per-metric, per-period counter.
// Concurrency-safe via UNIQUE (userId, metric, periodKey) and an atomic
// "UPDATE ... SET used = used + 1 WHERE used < limit" pattern that
// guarantees the limit is never exceeded even under heavy parallelism.
model QuotaUsage {
  id        String   @id @default(cuid())
  userId    String
  metric    String // "ai_conversations" | "ocr_scans" | "expenses"
  periodKey String // "YYYY-MM" (or "trial:<userId>")
  used      Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, metric, periodKey])
  @@index([periodKey])
}

// ----------------------------- Webhook side effects -----------------------------
// Durable idempotency for external side effects (emails, notifications).
// Insert with (eventId, effectType) — UNIQUE constraint guarantees
// at-most-once execution even under concurrent delivery, retry, or
// stale recovery. The first successful insert owns the side effect;
// subsequent callers observe P2002 and skip.
model WebhookSideEffect {
  id         String   @id @default(cuid())
  eventId    String
  effectType String
  metadata   String? // free-form JSON for debugging
  createdAt  DateTime @default(now())

  @@unique([eventId, effectType])
  @@index([eventId])
}
